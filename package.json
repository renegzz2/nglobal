    "@hello-pangea/dnd": "^18.0.1",
    "@supabase/supabase-js": "^2.95.3",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.0",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
